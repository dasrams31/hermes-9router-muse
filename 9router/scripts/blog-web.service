[Unit]
Description=Web server + view counter for blog.ramadanadipa.com (port 8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/hatch/workspace/blog/serve.py 8081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
