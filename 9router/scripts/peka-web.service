[Unit]
Description=Static web server for peka.ai.id landing page (port 8085)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/peka-ai/dist
ExecStart=/usr/bin/python3 -m http.server 8085 --bind 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
