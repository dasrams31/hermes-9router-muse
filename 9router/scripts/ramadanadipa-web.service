[Unit]
Description=Web server for ramadanadipa.com (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1 --directory /home/hatch/workspace/www/ramadanadipa.com
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
